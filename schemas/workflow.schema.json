{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kcenon/claude_code_agent/schemas/workflow.schema.json",
  "title": "AD-SDLC Workflow Configuration",
  "description": "Workflow syntax for AD-SDLC consumers. The SDK CLI additionally audits runtime support before execution; see docs/configuration/RUNTIME_WORKFLOW.md. Deprecated properties below have no SDK CLI enforcement owner.",
  "type": "object",
  "required": ["version", "pipeline"],
  "definitions": {
    "pipeline_stage": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Stage name"
        },
        "agent": {
          "type": "string",
          "description": "Agent to execute this stage"
        },
        "description": {
          "type": "string",
          "description": "Stage description"
        },
        "inputs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          },
          "description": "Input files/patterns (strings or typed objects)"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Output files/patterns"
        },
        "next": {
          "type": ["string", "null"],
          "description": "Next stage name"
        },
        "approval_required": {
          "type": "boolean",
          "default": false,
          "description": "Whether approval is required"
        },
        "parallel": {
          "type": "boolean",
          "default": false,
          "description": "Whether stage runs in parallel"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Max parallel workers"
        },
        "conditional": {
          "type": "boolean",
          "description": "Whether this stage is conditionally executed"
        },
        "on_ci_failure": {
          "type": "object",
          "description": "CI failure handling configuration",
          "properties": {
            "agent": {
              "type": "string",
              "description": "Agent to handle CI failure"
            },
            "description": {
              "type": "string",
              "description": "Description of failure handler"
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "description": "Max retry attempts on CI failure"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Inputs for failure handler"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Outputs from failure handler"
            }
          }
        },
        "substages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pipeline_stage"
          },
          "description": "Nested substages within this stage"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Legacy topology is rejected by SDK CLI. Move to execution.stage_timeouts_ms using canonical stage names."
        }
      }
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Configuration schema version (semver format)"
    },
    "name": {
      "type": "string",
      "description": "Workflow name"
    },
    "global": {
      "type": "object",
      "description": "Global settings",
      "properties": {
        "project_root": {
          "type": "string",
          "default": "${PWD}",
          "description": "Unsupported on SDK CLI workflows; remove. --project-dir selects the project, and the CLI uses the existing default session directory.",
          "deprecated": true
        },
        "scratchpad_dir": {
          "type": "string",
          "default": ".ad-sdlc/scratchpad",
          "description": "Unsupported on SDK CLI workflows; remove. --project-dir selects the project, and the CLI uses the existing default session directory.",
          "deprecated": true
        },
        "output_docs_dir": {
          "type": "string",
          "default": "docs",
          "description": "Unsupported on SDK CLI workflows; remove. --project-dir selects the project, and the CLI uses the existing default session directory.",
          "deprecated": true
        },
        "log_level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARN", "ERROR"],
          "default": "INFO",
          "description": "Unsupported on SDK CLI workflows; remove. --project-dir selects the project, and the CLI uses the existing default session directory.",
          "deprecated": true
        },
        "approval_mode": {
          "type": "string",
          "enum": ["auto", "manual", "critical", "custom"]
        },
        "approval_gates": {
          "type": "object",
          "description": "Unsupported on SDK CLI workflows; remove. --project-dir selects the project, and the CLI uses the existing default session directory.",
          "additionalProperties": {
            "type": "boolean"
          },
          "deprecated": true
        },
        "retry_policy": {
          "type": "object",
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Total attempts including the first. Runtime default 4, preserving the existing maxRetries: 3 API behavior."
            },
            "backoff": {
              "type": "string",
              "enum": ["fixed", "linear", "exponential", "fibonacci"]
            },
            "base_delay_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483
            },
            "max_delay_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483
            }
          }
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "document_generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483
            },
            "issue_creation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483
            },
            "orchestration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483
            },
            "implementation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483
            },
            "pr_review": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483
            }
          }
        },
        "vnv": {
          "type": "object",
          "properties": {
            "rigor": {
              "type": "string",
              "enum": ["strict", "standard", "minimal"]
            },
            "halt_on_verification_failure": {
              "type": "boolean"
            },
            "generate_vnv_plan": {
              "type": "boolean",
              "deprecated": true,
              "description": "Unsupported toggle on SDK CLI, including false; remove. Canonical stages and current verification semantics remain in effect."
            },
            "generate_vnv_report": {
              "type": "boolean",
              "deprecated": true,
              "description": "Unsupported toggle on SDK CLI, including false; remove. Canonical stages and current verification semantics remain in effect."
            },
            "generate_rtm": {
              "type": "boolean",
              "deprecated": true,
              "description": "Unsupported toggle on SDK CLI, including false; remove. Canonical stages and current verification semantics remain in effect."
            },
            "cross_document_consistency": {
              "type": "boolean",
              "deprecated": true,
              "description": "Unsupported toggle on SDK CLI, including false; remove. Canonical stages and current verification semantics remain in effect."
            },
            "acceptance_criteria_validation": {
              "type": "boolean",
              "deprecated": true,
              "description": "Unsupported toggle on SDK CLI, including false; remove. Canonical stages and current verification semantics remain in effect."
            }
          }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "description": "Pipeline configuration with optional mode-based stages",
      "properties": {
        "default_mode": {
          "type": "string",
          "enum": ["greenfield", "enhancement", "import"],
          "description": "Selects the canonical 19/15/5-slot graph (before local adaptation). Runtime default: greenfield."
        },
        "modes": {
          "type": "object",
          "description": "Unsupported topology on the SDK CLI. Remove and select pipeline.default_mode; use execution.stage_timeouts_ms for budgets.",
          "properties": {
            "greenfield": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "stages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/pipeline_stage"
                  }
                }
              },
              "required": ["stages"]
            },
            "enhancement": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "stages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/pipeline_stage"
                  }
                }
              },
              "required": ["stages"]
            },
            "import": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "stages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/pipeline_stage"
                  }
                }
              },
              "required": ["stages"]
            }
          },
          "deprecated": true
        },
        "stages": {
          "type": "array",
          "description": "Unsupported topology on the SDK CLI. Remove and select pipeline.default_mode; use execution.stage_timeouts_ms for budgets.",
          "items": {
            "$ref": "#/definitions/pipeline_stage"
          },
          "deprecated": true
        },
        "description": {
          "type": "string",
          "description": "Descriptive metadata, not runtime topology."
        }
      }
    },
    "agents": {
      "type": "object",
      "description": "Separate-consumer configuration, not enforced on the SDK CLI run path. Active settings are rejected by runtime resolution; remove them from CLI workflows.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "enum": ["sonnet", "opus", "haiku", "inherit"],
            "default": "sonnet",
            "description": "Claude model to use (inherit = use parent agent model)"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Read",
                "Write",
                "Edit",
                "Bash",
                "Glob",
                "Grep",
                "WebFetch",
                "WebSearch",
                "Task",
                "LSP",
                "TodoWrite",
                "NotebookEdit"
              ]
            },
            "description": "Tools available to the agent"
          },
          "template": {
            "type": "string",
            "description": "Template file path"
          },
          "max_questions": {
            "type": "integer",
            "minimum": 1,
            "description": "Max clarifying questions"
          },
          "github": {
            "type": "object",
            "properties": {
              "labels_prefix": {
                "type": "string"
              },
              "auto_assign": {
                "type": "boolean"
              },
              "merge_strategy": {
                "type": "string",
                "enum": ["merge", "squash", "rebase"]
              },
              "delete_branch_after_merge": {
                "type": "boolean"
              }
            }
          },
          "scheduling": {
            "type": "object",
            "properties": {
              "algorithm": {
                "type": "string",
                "enum": ["priority_only", "dependency_only", "priority_dependency"]
              },
              "max_workers": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "check_interval_seconds": {
                "type": "integer",
                "minimum": 10
              }
            }
          },
          "coding": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string"
              },
              "test_framework": {
                "type": "string"
              },
              "lint_command": {
                "type": "string"
              },
              "test_command": {
                "type": "string"
              },
              "build_command": {
                "type": "string"
              }
            }
          },
          "verification": {
            "type": "object",
            "properties": {
              "run_tests": {
                "type": "boolean",
                "default": true
              },
              "run_lint": {
                "type": "boolean",
                "default": true
              },
              "run_build": {
                "type": "boolean",
                "default": true
              },
              "coverage_threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "default": 80
              }
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "auto_merge": {
                "type": "boolean",
                "default": false
              },
              "require_all_checks": {
                "type": "boolean",
                "default": true
              },
              "coverage_threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "default": 80
              },
              "max_complexity": {
                "type": "integer",
                "minimum": 1,
                "default": 10
              }
            }
          }
        }
      },
      "deprecated": true
    },
    "quality_gates": {
      "type": "object",
      "description": "Separate-consumer configuration, not enforced on the SDK CLI run path. Active settings are rejected by runtime resolution; remove them from CLI workflows.",
      "properties": {
        "document_quality": {
          "type": "object",
          "properties": {
            "prd": {
              "type": "object",
              "properties": {
                "required_sections": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "min_requirements": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "srs": {
              "type": "object",
              "properties": {
                "required_sections": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "min_features": {
                  "type": "integer",
                  "minimum": 1
                },
                "min_use_cases_per_feature": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "sds": {
              "type": "object",
              "properties": {
                "required_sections": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "min_components": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "code_quality": {
          "type": "object",
          "properties": {
            "coverage_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 80
            },
            "max_complexity": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            },
            "max_line_length": {
              "type": "integer",
              "minimum": 80,
              "default": 100
            },
            "no_todos_in_code": {
              "type": "boolean",
              "default": false
            },
            "no_console_logs": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "no_hardcoded_secrets": {
              "type": "boolean",
              "default": true
            },
            "require_input_validation": {
              "type": "boolean",
              "default": true
            },
            "require_authentication": {
              "type": "boolean",
              "default": true
            }
          }
        }
      },
      "deprecated": true
    },
    "notifications": {
      "type": "object",
      "description": "Separate-consumer configuration, not enforced on the SDK CLI run path. Active settings are rejected by runtime resolution; remove them from CLI workflows.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["slack", "email"]
              },
              "webhook": {
                "type": "string"
              },
              "recipients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["stage_complete", "approval_required", "error", "pipeline_complete"]
                }
              }
            }
          }
        },
        "templates": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "deprecated": true
    },
    "github": {
      "type": "object",
      "description": "Separate-consumer configuration, not enforced on the SDK CLI run path. Active settings are rejected by runtime resolution; remove them from CLI workflows.",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository in owner/repo format"
        },
        "default_branch": {
          "type": "string",
          "default": "main"
        },
        "issue_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pr_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestone_prefix": {
          "type": "string"
        }
      },
      "deprecated": true
    },
    "logging": {
      "type": "object",
      "description": "Separate-consumer configuration, not enforced on the SDK CLI run path. Active settings are rejected by runtime resolution; remove them from CLI workflows.",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARN", "ERROR"],
          "default": "INFO"
        },
        "format": {
          "type": "string",
          "enum": ["json", "text"],
          "default": "json"
        },
        "output": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["file", "console"]
              },
              "path": {
                "type": "string"
              },
              "rotate": {
                "type": "boolean"
              },
              "max_size": {
                "type": "string"
              },
              "max_files": {
                "type": "integer",
                "minimum": 1
              },
              "format": {
                "type": "string",
                "enum": ["json", "pretty"]
              }
            }
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "deprecated": true
    },
    "monitoring": {
      "type": "object",
      "description": "Separate-consumer configuration, not enforced on the SDK CLI run path. Active settings are rejected by runtime resolution; remove them from CLI workflows.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "deprecated": true
    },
    "scratchpad": {
      "type": "object",
      "description": "Separate-consumer configuration, not enforced on the SDK CLI run path. Active settings are rejected by runtime resolution; remove them from CLI workflows.",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["file", "sqlite", "redis"],
          "default": "file",
          "description": "Storage backend type"
        },
        "file": {
          "type": "object",
          "description": "File backend configuration",
          "properties": {
            "base_path": {
              "type": "string"
            },
            "file_mode": {
              "type": "integer"
            },
            "dir_mode": {
              "type": "integer"
            },
            "format": {
              "type": "string",
              "enum": ["yaml", "json", "raw"]
            }
          }
        },
        "sqlite": {
          "type": "object",
          "description": "SQLite backend configuration",
          "properties": {
            "db_path": {
              "type": "string"
            },
            "wal_mode": {
              "type": "boolean"
            },
            "busy_timeout": {
              "type": "integer"
            }
          }
        },
        "redis": {
          "type": "object",
          "description": "Redis backend configuration",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "password": {
              "type": "string"
            },
            "db": {
              "type": "integer"
            },
            "prefix": {
              "type": "string"
            },
            "ttl": {
              "type": "integer"
            },
            "connect_timeout": {
              "type": "integer"
            },
            "max_retries": {
              "type": "integer"
            },
            "lock": {
              "type": "object",
              "properties": {
                "lock_ttl": {
                  "type": "integer"
                },
                "lock_timeout": {
                  "type": "integer"
                },
                "lock_retry_interval": {
                  "type": "integer"
                }
              }
            },
            "fallback": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "file_config": {
                  "type": "object",
                  "properties": {
                    "base_path": {
                      "type": "string"
                    },
                    "file_mode": {
                      "type": "integer"
                    },
                    "dir_mode": {
                      "type": "integer"
                    },
                    "format": {
                      "type": "string",
                      "enum": ["yaml", "json", "raw"]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "deprecated": true
    },
    "telemetry": {
      "type": "object",
      "description": "Separate-consumer configuration, not enforced on the SDK CLI run path. Active settings are rejected by runtime resolution; remove them from CLI workflows.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "flush_interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "default": 60000
        },
        "max_buffer_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "include_debug_events": {
          "type": "boolean",
          "default": false
        }
      },
      "deprecated": true
    },
    "token_budgets": {
      "type": "object",
      "description": "Separate-consumer configuration, not enforced on the SDK CLI run path. Active settings are rejected by runtime resolution; remove them from CLI workflows.",
      "properties": {
        "default_model": {
          "type": "string",
          "enum": ["sonnet", "opus", "haiku", "inherit"],
          "description": "Default model for budget calculations (inherit = use parent agent model)"
        },
        "pipeline": {
          "type": "object",
          "description": "Pipeline-level token budget",
          "properties": {
            "max_tokens": {
              "type": "integer",
              "description": "Maximum tokens for the entire pipeline"
            },
            "max_cost_usd": {
              "type": "number",
              "description": "Maximum cost in USD for the pipeline"
            },
            "warning_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Threshold (0-1) to trigger budget warning"
            }
          }
        },
        "defaults": {
          "type": "object",
          "description": "Default budgets per agent category or role",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "max_tokens": {
                "type": "integer"
              },
              "max_cost_usd": {
                "type": "number"
              }
            }
          }
        },
        "agents": {
          "type": "object",
          "description": "Per-agent token budgets",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "max_tokens": {
                "type": "integer"
              },
              "max_cost_usd": {
                "type": "number"
              }
            }
          }
        }
      },
      "deprecated": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "max_parallel_stages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "local_mode": {
          "type": "boolean"
        },
        "stage_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "Total stage budget across attempts and backoff. Runtime default 300000 ms. Higher-priority layers win before timeout specificity."
        },
        "stage_timeouts_ms": {
          "type": "object",
          "propertyNames": {
