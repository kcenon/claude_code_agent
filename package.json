{
  "name": "ad-sdlc",
  "version": "0.1.0",
  "description": "Agent-Driven Software Development Lifecycle system built with Claude Agent SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "ad-sdlc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:bench": "vitest bench --config vitest.bench.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:memory": "vitest run --config vitest.perf.config.ts tests/performance/memory/",
    "test:scalability": "vitest run --config vitest.perf.config.ts tests/performance/scalability/",
    "perf:check": "tsx scripts/check-regression.ts",
    "perf:update-baseline": "tsx scripts/update-baseline.ts",
    "audit:docs": "tsx scripts/audit-docs.ts",
    "docs:check": "npm run docs:check-symbols && npm run docs:check-inventory",
    "docs:check-inventory": "tsx scripts/ci/validate-doc-inventory.ts",
    "docs:check-symbols": "tsx scripts/ci/validate-doc-symbols.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "clean": "rm -rf dist",
    "prepare": "husky || true",
    "todo": "grep -rn 'TODO' src/ --include='*.ts' | sort",
    "todo:fixme": "grep -rn 'FIXME' src/ --include='*.ts' | sort",
    "todo:hack": "grep -rn 'HACK' src/ --include='*.ts' | sort",
    "todo:all": "grep -rn -E '(TODO|FIXME|HACK)' src/ --include='*.ts' | sort",
    "todo:count": "echo 'TODO:' && grep -r 'TODO' src/ --include='*.ts' | wc -l && echo 'FIXME:' && grep -r 'FIXME' src/ --include='*.ts' | wc -l && echo 'HACK:' && grep -r 'HACK' src/ --include='*.ts' | wc -l",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "keywords": [
    "claude",
    "agent",
    "sdlc",
    "ai",
    "automation",
    "software-development"
  ],
  "author": "kcenon",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kcenon/claude_code_agent.git"
  },
  "bugs": {
    "url": "https://github.com/kcenon/claude_code_agent/issues"
  },
  "homepage": "https://github.com/kcenon/claude_code_agent#readme",
  "engines": {
    "node": ">=22.22.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1115.0",
    "@elastic/elasticsearch": "^9.5.0",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.4.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/inquirer": "^9.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.2.1",
    "husky": "^9.1.7",
    "ioredis": "^6.0.0",
    "lint-staged": "^17.3.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.238",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "inquirer": "^14.1.0",
    "js-yaml": "^5.3.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1009.0",
    "@elastic/elasticsearch": "^9.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.4.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "better-sqlite3": "^13.0.3",
    "ioredis": "^6.0.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-cloudwatch-logs": {
      "optional": true
    },
    "@elastic/elasticsearch": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "pdf-parse": {
      "optional": true
    }
  },
  "overrides": {
    "fast-xml-parser": "^5.5.6"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}
