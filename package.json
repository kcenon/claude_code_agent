{
  "name": "ad-sdlc",
  "version": "0.0.1",
  "description": "Agent-Driven Software Development Lifecycle system built with Claude Agent SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "ad-sdlc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:bench": "vitest bench --config vitest.bench.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:memory": "vitest run --config vitest.perf.config.ts tests/performance/memory/",
    "test:scalability": "vitest run --config vitest.perf.config.ts tests/performance/scalability/",
    "perf:check": "node --experimental-specifier-resolution=node dist/scripts/check-regression.js",
    "perf:update-baseline": "node --experimental-specifier-resolution=node dist/scripts/update-baseline.js",
    "audit:docs": "tsx scripts/audit-docs.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "clean": "rm -rf dist",
    "prepare": "husky || true",
    "todo": "grep -rn 'TODO' src/ --include='*.ts' | sort",
    "todo:fixme": "grep -rn 'FIXME' src/ --include='*.ts' | sort",
    "todo:hack": "grep -rn 'HACK' src/ --include='*.ts' | sort",
    "todo:all": "grep -rn -E '(TODO|FIXME|HACK)' src/ --include='*.ts' | sort",
    "todo:count": "echo 'TODO:' && grep -r 'TODO' src/ --include='*.ts' | wc -l && echo 'FIXME:' && grep -r 'FIXME' src/ --include='*.ts' | wc -l && echo 'HACK:' && grep -r 'HACK' src/ --include='*.ts' | wc -l",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "keywords": [
    "claude",
    "agent",
    "sdlc",
    "ai",
    "automation",
    "software-development"
  ],
  "author": "kcenon",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kcenon/claude_code_agent.git"
  },
  "bugs": {
    "url": "https://github.com/kcenon/claude_code_agent/issues"
  },
  "homepage": "https://github.com/kcenon/claude_code_agent#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1057.0",
    "@elastic/elasticsearch": "^9.4.2",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.4.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/inquirer": "^9.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.8",
    "better-sqlite3": "^12.10.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.1",
    "husky": "^9.1.7",
    "ioredis": "^5.11.0",
    "lint-staged": "^17.0.7",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.177",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "inquirer": "^14.0.2",
    "js-yaml": "^4.2.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1009.0",
    "@elastic/elasticsearch": "^9.4.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.4.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "better-sqlite3": "^12.10.0",
    "ioredis": "^5.11.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-cloudwatch-logs": {
      "optional": true
    },
    "@elastic/elasticsearch": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "pdf-parse": {
      "optional": true
    }
  },
  "overrides": {
    "fast-xml-parser": "^5.5.6"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}
